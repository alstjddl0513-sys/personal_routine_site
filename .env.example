# 이 파일을 루트에 `.env`로 복사해 사용. API(NestJS)는 여기 값을 읽음.
# Web(Next.js) 관련 var(Web 섹션 아래)는 로컬 dev에서 Next가 읽으려면
# apps/web/.env에도 동일 값을 두거나, 최소한 Web 섹션의 필요한 var만 옮기기.
# 배포에선 각 var가 Render/Vercel 대시보드 Env로 주입됨(.env 파일 안 씀).

# --- API (NestJS) ---

# Supabase (PostgreSQL) connection string.
# 형식: postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
DATABASE_URL=

# NestJS 서버 포트. Render 등 PaaS는 PORT를 주입하므로 배포에선 비워도 됨.
API_PORT=3001

# CORS 허용 오리진. Comma-separated로 여러 개 가능.
# 예: http://localhost:3000,https://rally-web.vercel.app
CORS_ALLOWED_ORIGIN=http://localhost:3000

# API 접근 토큰. Web의 /api/proxy가 X-Auth-Token 헤더로 첨부.
# 배포에선 필수(예: openssl rand -hex 32). 로컬 dev에선 비워두면 가드 스킵.
# Phase 12.2에서 Supabase Auth로 교체 예정 — 그때 제거.
API_ACCESS_TOKEN=

# Supabase Auth (Phase 12).
# 12.1: SupabaseAuthGuard 스캐폴드 파일 존재(env 비면 no-op, 아직 미등록).
# 12.2에서 AppModule 등록 + 프론트 로그인 교체.
# 이 프로젝트는 JWKS(ES256/ECC P-256)로 서명. Guard가 <SUPABASE_URL>/auth/v1/
# .well-known/jwks.json에서 공개키 fetch. shared secret 불필요.
SUPABASE_URL=


# --- Web (Next.js) ---

# 서버 컴포넌트 & /api/proxy가 실제로 호출할 API URL.
# 브라우저에 노출되지 않음(NEXT_PUBLIC_ 접두어 없음).
# 로컬: http://localhost:3001, 배포: https://<render-service>.onrender.com
API_INTERNAL_URL=http://localhost:3001

# 로그인 자격증명. 둘 다 세팅되면 /login 폼 기반 인증 활성화(쿠키 세션).
# 비워두면 인증 스킵(로컬 dev 편의). 로컬에서 로그인 흐름 테스트하려면
# apps/web/.env에도 동일 값 필요(Next는 apps/web/.env를 우선 읽음).
# Phase 12.2에서 Supabase Auth로 교체 예정 — 그때 제거.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Supabase Auth (Phase 12.2부터 필요).
# 브라우저에 노출되는 값(NEXT_PUBLIC_ 접두어). apps/web/.env에도 동일 값 필요.
# 이 프로젝트는 새 API keys 구조(sb_publishable_* / sb_secret_*). Console →
# Settings → API Keys에서 복사. publishable key는 브라우저 노출 안전하되
# RLS 정책 활성이 전제 → Phase 12.4 완료 전 prod 배포 금지.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
